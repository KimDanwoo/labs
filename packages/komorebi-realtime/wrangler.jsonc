{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "komorebi-realtime",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-12",
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "WalkRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WalkRoom"] }],
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:3011,http://localhost:3011,http://127.0.0.1:3111",
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false },
  },
}
