#!/bin/sh
# push 전에 바뀐 앱의 e2e를 돌린다. CI는 e2e를 돌리지 않는다. 건너뛰기: git push --no-verify
# 테스트는 작업 트리 기준이라 체크아웃한 브랜치를 push할 때 의미가 있다.
set -e

changed=''
while read -r _ local_sha _ _; do
  case $local_sha in *[!0]*) ;; *) continue ;; esac # 브랜치 삭제
  base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || continue
  changed="$changed
$(git diff --name-only "$base" "$local_sha")"
done

has_change() { printf '%s\n' "$changed" | grep -q "^apps/$1/"; }

if has_change prairie; then
  echo '▶ prairie 변경 — 빌드 후 e2e'
  pnpm turbo run build --filter=prairie # 의존 패키지(토큰)까지 빌드한다
  pnpm --filter prairie test:e2e
fi

if has_change fe-deep; then
  echo '▶ fe-deep 변경 — e2e'
  pnpm --filter fe-deep test:e2e
fi
