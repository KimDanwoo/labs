{
  "name": "Komorebi — 여름빛 산책",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "remoteUser": "node",
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "npx --yes pnpm@9.12.1 --filter komorebi... install --frozen-lockfile",
  "postStartCommand": "node apps/komorebi/scripts/cloud-start.mjs",
  "forwardPorts": [3011],
  "portsAttributes": {
    "3011": { "label": "여름빛 산책", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "settings": { "workbench.startupEditor": "readme", "files.autoSave": "afterDelay" }
    }
  }
}
