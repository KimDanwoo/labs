{
  "name": "labs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "pnpm check:architecture && pnpm lint:workspace && turbo run lint",
    "lint:workspace": "eslint .",
    "test": "node --test \"scripts/__tests__/*.test.mjs\" && turbo run test",
    "check:architecture": "node scripts/check-architecture.mjs",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,css,md}\"",
    "brand-assets": "node scripts/brand-assets.mjs"
  },
  "prettier": "@repo/prettier-config",
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "next": "catalog:",
      "eslint-config-next": "catalog:",
      "sharp@<0.35.5": "catalog:",
      "undici@>=8 <8.12.2": "^8.12.2",
      "zod@>=4 <4.6.6": "^4.6.6",
      "source-map-js@<1.2.2": "^1.2.2",
      "fflate@<0.7.5": "^0.7.5",
      "smol-toml@<1.9.0": "^1.9.0",
      "fast-xml-parser@>=5 <5.12.0": "^5.12.0",
      "postcss-selector-parser@>=7 <7.1.6": "^7.1.6",
      "@grpc/grpc-js@<1.13.6": "^1.13.6",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4 <5.0.12": "^5.0.12",
      "fast-uri@<3.1.7": "^3.1.7",
      "systeminformation@<5.33.16": "^5.33.16",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "ip-address@<10.7.4": "^10.7.4",
      "minimatch@>=7 <11.0.1": "^11.0.1"
    }
  }
}
