{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "tokens": {
      "outputs": ["generated/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["ANALYZE"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/__tests__/**",
        "!e2e/**",
        "!playwright.config.*",
        "!vitest.config.*"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**", "out/**", "generated/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    }
  }
}
