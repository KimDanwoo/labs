---
import { postPath, type Post } from '~/lib/posts';

type Props = {
  older?: Post;
  newer?: Post;
};

const { older, newer } = Astro.props;
const linkClass =
  'group flex flex-col gap-xs rounded-lg p-md transition-colors hover:bg-primary-subtle hover:text-primary';
---

{
  (older || newer) && (
    <nav aria-label="이전 글과 다음 글" class="-mx-md grid gap-xs sm:grid-cols-2">
      {older ? (
        <a href={postPath(older)} class={linkClass} rel="prev">
          <span class="text-sm text-muted-foreground">← 이전 글</span>
          <span class="leading-snug font-bold">{older.data.title}</span>
        </a>
      ) : (
        <span class="hidden sm:block" />
      )}
      {newer && (
        <a href={postPath(newer)} class:list={[linkClass, 'sm:text-right']} rel="next">
          <span class="text-sm text-muted-foreground">다음 글 →</span>
          <span class="leading-snug font-bold">{newer.data.title}</span>
        </a>
      )}
    </nav>
  )
}
