---
import { Image } from 'astro:assets';
import { postPath, type Post } from '~/lib/posts';

type Props = {
  older?: Post;
  newer?: Post;
};

// 2배 해상도 화면을 고려해 표시 크기(4rem)의 두 배로 만든다
const THUMBNAIL_SIZE = 128;

const { older, newer } = Astro.props;
const entries = [
  { post: older, label: '← 이전 글', rel: 'prev', isNewer: false },
  { post: newer, label: '다음 글 →', rel: 'next', isNewer: true },
];
---

{
  (older || newer) && (
    <nav aria-label="이전 글과 다음 글" class="-mx-md grid gap-xs sm:grid-cols-2">
      {entries.map(({ post, label, rel, isNewer }) =>
        post ? (
          <a
            href={postPath(post)}
            rel={rel}
            class:list={[
              'group flex items-center gap-md rounded-lg p-md transition-colors hover:bg-primary-subtle hover:text-primary',
              isNewer && 'sm:flex-row-reverse sm:text-right',
            ]}
          >
            {post.data.thumbnail && (
              <span class="size-16 shrink-0 overflow-hidden rounded-md bg-muted ring-1 ring-border">
                <Image
                  src={post.data.thumbnail}
                  alt=""
                  width={THUMBNAIL_SIZE}
                  height={THUMBNAIL_SIZE}
                  class="size-full object-cover transition-transform duration-300 ease-out group-hover:scale-105"
                />
              </span>
            )}
            <span class="flex min-w-0 flex-1 flex-col gap-xs">
              <span class="text-sm text-muted-foreground">{label}</span>
              <span class="line-clamp-2 leading-snug font-bold">{post.data.title}</span>
            </span>
          </a>
        ) : (
          !isNewer && <span class="hidden sm:block" />
        ),
      )}
    </nav>
  )
}
