---
const GISCUS = {
  repo: 'KimDanwoo/dansoon-comments',
  repoId: 'R_kgDOVjp52Q',
  category: 'Announcements',
  categoryId: 'DIC_kwDOVjp52c4DKbbw',
} as const;
---

<section aria-label="댓글">
  <div class="giscus" data-giscus-config={JSON.stringify(GISCUS)}></div>
</section>

<script>
  const GISCUS_ORIGIN = 'https://giscus.app';
  const themeName = () => (document.documentElement.classList.contains('dark') ? 'dark' : 'light');
  const giscusFrame = () => document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');

  const sendTheme = () =>
    giscusFrame()?.contentWindow?.postMessage({ giscus: { setConfig: { theme: themeName() } } }, GISCUS_ORIGIN);

  const isFrameResize = (data: unknown) =>
    typeof data === 'object' &&
    data !== null &&
    'giscus' in data &&
    typeof data.giscus === 'object' &&
    data.giscus !== null &&
    'resizeHeight' in data.giscus;

  function mountGiscus() {
    const container = document.querySelector<HTMLElement>('.giscus[data-giscus-config]');
    if (!container) return;
    const config = JSON.parse(container.dataset.giscusConfig ?? '{}') as Record<string, string>;
    const script = document.createElement('script');
    script.src = `${GISCUS_ORIGIN}/client.js`;
    script.async = true;
    script.crossOrigin = 'anonymous';
    Object.entries({
      'data-repo': config.repo,
      'data-repo-id': config.repoId,
      'data-category': config.category,
      'data-category-id': config.categoryId,
      'data-mapping': 'pathname',
      'data-strict': '1',
      'data-reactions-enabled': '1',
      'data-input-position': 'top',
      'data-lang': 'ko',
      'data-loading': 'lazy',
      'data-theme': themeName(),
    }).forEach(([key, value]) => value && script.setAttribute(key, value));
    container.after(script);
  }

  document.addEventListener('astro:page-load', mountGiscus);
  document.addEventListener('themechange', sendTheme);
  // 댓글 iframe은 화면에 들어와야 뜨고(data-loading: lazy) 로그아웃하면 처음 주소로 다시 뜬다. 뜨기 전에 보낸 테마는
  // 버려지므로, iframe이 떴다고 알리는 높이 메시지를 받을 때마다 지금 테마를 다시 보낸다
  // https://github.com/giscus/giscus/blob/main/client.ts
  window.addEventListener('message', (event: MessageEvent<unknown>) => {
    const isFromFrame = event.origin === GISCUS_ORIGIN && event.source === giscusFrame()?.contentWindow;
    if (isFromFrame && isFrameResize(event.data)) sendTheme();
  });
</script>
