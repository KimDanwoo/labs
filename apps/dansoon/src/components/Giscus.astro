---
/**
 * giscus 댓글(GitHub Discussions). 댓글 전용 공개 저장소 KimDanwoo/dansoon-comments에 쌓인다.
 * Announcements 카테고리는 관리자와 giscus만 토론을 만들 수 있어 스팸 글을 막는다.
 * 저장소에 giscus 앱(https://github.com/apps/giscus)이 설치돼 있어야 댓글을 쓸 수 있다.
 */
const GISCUS = {
  repo: 'KimDanwoo/dansoon-comments',
  repoId: 'R_kgDOVjp52Q',
  category: 'Announcements',
  categoryId: 'DIC_kwDOVjp52c4DKbbw',
} as const;

const isConfigured = GISCUS.categoryId !== '';
---

{
  isConfigured && (
    <section aria-label="댓글">
      <div class="giscus" data-giscus-config={JSON.stringify(GISCUS)} />
    </section>
  )
}

<script>
  const GISCUS_ORIGIN = 'https://giscus.app';
  const themeName = () => (document.documentElement.classList.contains('dark') ? 'dark' : 'light');

  function mountGiscus() {
    const container = document.querySelector<HTMLElement>('.giscus[data-giscus-config]');
    if (!container) return;
    const config = JSON.parse(container.dataset.giscusConfig ?? '{}') as Record<string, string>;
    const script = document.createElement('script');
    script.src = `${GISCUS_ORIGIN}/client.js`;
    script.async = true;
    script.crossOrigin = 'anonymous';
    Object.entries({
      'data-repo': config.repo,
      'data-repo-id': config.repoId,
      'data-category': config.category,
      'data-category-id': config.categoryId,
      'data-mapping': 'pathname',
      'data-strict': '1',
      'data-reactions-enabled': '1',
      'data-input-position': 'top',
      'data-lang': 'ko',
      'data-loading': 'lazy',
      'data-theme': themeName(),
    }).forEach(([key, value]) => value && script.setAttribute(key, value));
    container.after(script);
  }

  document.addEventListener('astro:page-load', mountGiscus);
  // 사이트 테마를 바꾸면 지금 페이지의 댓글 iframe에도 알린다(한 번만 등록)
  document.addEventListener('themechange', () => {
    const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: themeName() } } }, GISCUS_ORIGIN);
  });
</script>
