---
import Icon from '~/components/Icon.astro';
---

<div
  data-sidebar-header
  class="border-b border-transparent px-md pt-lg pb-md transition-colors data-scrolled:border-border"
>
  <a href="/" class="block px-sm">
    <span class="block text-lg font-bold tracking-tight">Dansoon</span>
  </a>

  <button
    type="button"
    data-search-open
    class="mt-lg flex h-9 w-full items-center gap-sm rounded-md bg-background px-sm text-sm text-muted-foreground ring-1 ring-border transition-colors hover:text-foreground"
    aria-label="글 검색"
    aria-keyshortcuts="Meta+K Control+K"
  >
    <Icon name="search" class="size-3.5" />
    <span>검색</span>
    <kbd class="ml-auto text-xs text-muted-foreground">⌘K</kbd>
  </button>
</div>
