---
import { categoryPath, countBy, type Post } from '~/lib/posts';
import { CATEGORY_IDS, CATEGORY_LABEL, type CategoryId } from '~/lib/taxonomy';

type Props = {
  posts: Post[];
  active: CategoryId | 'all';
};

const { posts, active } = Astro.props;
const counts = countBy(posts, (post) => [post.data.category]);
const tabs = [
  { id: 'all', label: '전체', href: '/', count: posts.length },
  ...CATEGORY_IDS.map((id) => ({ id, label: CATEGORY_LABEL[id], href: categoryPath(id), count: counts.get(id) ?? 0 })),
];
---

<!-- 가로 스크롤 영역은 세로도 잘라 칩 밖으로 4px 나오는 포커스 테두리가 잘렸다 — 안쪽 여백을 두고 같은 크기의 음수 마진으로 자리를 되돌린다 -->
<nav aria-label="카테고리" data-overlay-scroll class="-mx-md -my-xs overflow-x-auto px-md py-xs sm:-mx-xs sm:px-xs">
  <ul class="flex gap-xs">
    {
      tabs.map((tab) => (
        <li>
          <a
            href={tab.href}
            aria-current={tab.id === active ? 'page' : undefined}
            class="inline-flex h-10 items-center gap-xs rounded-full px-md text-sm whitespace-nowrap text-muted-foreground transition-colors hover:bg-muted hover:text-foreground active:bg-muted aria-[current=page]:bg-primary aria-[current=page]:font-bold aria-[current=page]:text-primary-foreground sm:h-9"
          >
            {tab.id !== 'all' && <span data-category={tab.id} class="category-dot" aria-hidden="true" />}
            {tab.label}
            <span class="text-xs tabular-nums">{tab.count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
