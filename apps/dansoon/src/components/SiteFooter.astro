  >
    <p>© {new Date().getFullYear()} Dansoon</p>
    <nav aria-label="사이트 정보" class="flex items-center gap-md">
      <a href="/about/" class="hover:text-foreground">소개</a>
      <a href="/privacy/" class="hover:text-foreground">개인정보처리방침</a>
      <a href="/rss.xml" class="inline-flex items-center gap-xs hover:text-foreground">
        <Icon name="rss" class="size-3.5" />
        RSS
      </a>
    </nav>
  </div>
</footer>
