---
import Icon from '~/components/Icon.astro';
---

<footer class="border-t border-border">
  <div
    class="mx-auto flex max-w-(--container-3xl) flex-col-reverse gap-sm px-md py-lg text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:gap-md sm:px-xl sm:text-xs"
  >
    <p>© {new Date().getFullYear()} Dansoon</p>
    <nav aria-label="사이트 정보" class="-mx-sm flex flex-wrap items-center sm:mx-0 sm:justify-end">
      <a href="/about/" class="rounded-sm px-sm py-xs transition-colors hover:text-foreground active:text-foreground"
        >소개</a
      >
      <a href="/contact/" class="rounded-sm px-sm py-xs transition-colors hover:text-foreground active:text-foreground"
        >문의</a
      >
      <a href="/terms/" class="rounded-sm px-sm py-xs transition-colors hover:text-foreground active:text-foreground"
        >이용약관</a
      >
      <a href="/privacy/" class="rounded-sm px-sm py-xs transition-colors hover:text-foreground active:text-foreground"
        >개인정보처리방침</a
      >
      <a
        href="/rss.xml"
        class="inline-flex items-center gap-xs rounded-sm px-sm py-xs transition-colors hover:text-foreground active:text-foreground"
      >
        <Icon name="rss" class="size-3.5" />
        RSS
      </a>
    </nav>
  </div>
</footer>
