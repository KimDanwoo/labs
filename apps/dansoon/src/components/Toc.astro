---
import type { MarkdownHeading } from 'astro';
import Icon from '~/components/Icon.astro';

const TOC_DEPTHS = [2, 3];

type Props = {
  headings: MarkdownHeading[];
  variant: 'sidebar' | 'inline';
};

const { headings, variant } = Astro.props;
const items = headings.filter((heading) => TOC_DEPTHS.includes(heading.depth));
const linkClass =
  'toc-link block border-l-2 border-transparent py-1.5 pr-sm leading-snug transition-colors hover:text-foreground';
const indentOf = (depth: number) => (depth === 2 ? 'pl-md' : 'pl-xl');
---

{
  items.length > 0 &&
    (variant === 'sidebar' ? (
      <nav aria-label="목차" data-toc class="text-sm text-muted-foreground">
        <p class="mb-md text-sm font-bold text-foreground">목차</p>
        <ul class="border-l border-border">
          {items.map((heading) => (
            <li>
              <a href={`#${heading.slug}`} data-toc-link class:list={[linkClass, indentOf(heading.depth), '-ml-px']}>
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ) : (
      <details class="motion-details group rounded-lg bg-muted text-sm">
        <summary class="flex cursor-pointer list-none items-center justify-between px-md py-sm font-bold">
          <span class="flex items-center gap-sm">
            <Icon name="list" class="size-3.5" />
            목차
          </span>
          <Icon name="chevron-down" class="size-4 text-muted-foreground transition-transform group-open:rotate-180" />
        </summary>
        <ul class="px-sm pb-sm text-muted-foreground">
          {items.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                data-toc-link
                class:list={['block rounded-md py-xs hover:text-foreground', indentOf(heading.depth)]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))
}

<script>
  /** 화면 위쪽에 걸린 마지막 제목을 현재 위치로 표시한다. 페이지를 옮길 때마다 새 글의 제목으로 다시 연결한다. */
  let pageListeners: AbortController | undefined;

  function initToc() {
    pageListeners?.abort();
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')];
    const headings = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((heading): heading is HTMLElement => heading !== null);
    if (headings.length === 0) return;

    const markCurrent = () => {
      const threshold = window.innerHeight * 0.25;
      const passed = headings.filter((heading) => heading.getBoundingClientRect().top <= threshold);
      const current = passed.at(-1) ?? headings[0];
      for (const link of links) {
        link.setAttribute('aria-current', String(link.hash.slice(1) === encodeURIComponent(current?.id ?? '')));
      }
    };

    // 스크롤·리사이즈마다 한 프레임에 한 번만 다시 계산한다. 다음 페이지로 가면 이 리스너는 정리된다.
    pageListeners = new AbortController();
    let frame = 0;
    const schedule = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(markCurrent);
    };
    // 데스크톱은 본문 영역이, 모바일은 문서가 스크롤된다 — 캡처 단계에서 모든 스크롤을 받는다
    document.addEventListener('scroll', schedule, { capture: true, passive: true, signal: pageListeners.signal });
    window.addEventListener('resize', schedule, { passive: true, signal: pageListeners.signal });
    markCurrent();
  }

  document.addEventListener('astro:page-load', initToc);

  /**
   * 목차를 누르면 제목까지 부드럽게 이동한다. 데스크톱은 문서가 아니라 본문 영역이 스크롤되므로
   * html의 scroll-behavior가 닿지 않는다 — 제목 요소에 직접 scrollIntoView를 건다.
   * 페이지 전환 라우터보다 먼저 받도록 캡처 단계에서 처리한다.
   */
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.addEventListener(
    'click',
    (event) => {
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[data-toc-link]') : null;
      const heading = link ? document.getElementById(decodeURIComponent(link.hash.slice(1))) : null;
      if (!link || !heading) return;
      event.preventDefault();
      heading.scrollIntoView({ behavior: prefersReducedMotion.matches ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(history.state, '', link.hash);
    },
    { capture: true },
  );
</script>
