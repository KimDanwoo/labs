---
import Icon, { type IconName } from '~/components/Icon.astro';
import ThemeToggle from '~/components/ThemeToggle.astro';
import { filterByCategory, postPath, seriesPath, type Post } from '~/lib/posts';
import { CATEGORY_IDS, CATEGORY_LABEL, SERIES_INFO } from '~/lib/taxonomy';

type Props = {
  posts: Post[];
};

/** 노션식 사이드바: 바로가기 + 카테고리 폴더(펼치면 글 목록). 지금 글이 든 폴더만 펼쳐 둔다. */
const { posts } = Astro.props;
const { pathname } = Astro.url;
const currentPost = posts.find((post) => postPath(post) === pathname);

const SHORTCUTS: { href: string; label: string; icon: IconName; isActive: boolean }[] = [
  { href: '/', label: '전체 글', icon: 'home', isActive: pathname === '/' || pathname.startsWith('/categories') },
  { href: '/tags/', label: '태그', icon: 'hash', isActive: pathname.startsWith('/tags') },
  {
    href: seriesPath('hanghae-plus'),
    label: `연재 · ${SERIES_INFO['hanghae-plus'].label}`,
    icon: 'layers',
    isActive: pathname.startsWith('/series'),
  },
];
const folders = CATEGORY_IDS.map((category) => ({
  category,
  label: CATEGORY_LABEL[category],
  posts: filterByCategory(posts, category),
}));

const itemClass =
  'flex items-center gap-sm rounded-md px-sm py-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground aria-[current=page]:bg-muted aria-[current=page]:font-semibold aria-[current=page]:text-foreground';
---

<div class="flex min-h-full flex-col gap-lg p-sm text-sm">
  <a href="/" class="flex items-center gap-sm rounded-md px-sm py-xs hover:bg-muted">
    <span class="grid size-6 place-items-center rounded-md bg-foreground text-xs font-bold text-background">D</span>
    <span class="text-base font-bold">Dansoon</span>
  </a>

  <button
    type="button"
    data-search-open
    class="flex h-8 items-center gap-sm rounded-md border border-border bg-background px-sm text-muted-foreground shadow-sm transition-colors hover:text-foreground"
    aria-label="글 검색"
    aria-keyshortcuts="Meta+K Control+K"
  >
    <Icon name="search" class="size-3.5" />
    <span>검색</span>
    <kbd class="ml-auto text-xs">⌘K</kbd>
  </button>

  <nav aria-label="바로가기">
    <ul class="space-y-px">
      {
        SHORTCUTS.map((item) => (
          <li>
            <a href={item.href} class={itemClass} aria-current={item.isActive ? 'page' : undefined}>
              <Icon name={item.icon} class="size-4 shrink-0" />
              <span class="truncate">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <nav aria-label="카테고리별 글">
    <p class="px-sm pb-xs text-xs font-semibold text-muted-foreground">카테고리</p>
    <ul class="space-y-px">
      {
        folders.map((folder) => (
          <li>
            <details open={folder.category === currentPost?.data.category} class="group">
              <summary class="flex cursor-pointer list-none items-center gap-sm rounded-md px-sm py-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground [&::-webkit-details-marker]:hidden">
                <Icon name="chevron-right" class="size-3.5 shrink-0 transition-transform group-open:rotate-90" />
                <Icon name="folder" class="size-4 shrink-0" />
                <span class="font-medium text-foreground">{folder.label}</span>
                <span class="ml-auto text-xs tabular-nums">{folder.posts.length}</span>
              </summary>
              <ul class="mt-px ml-md space-y-px border-l border-border pl-xs">
                {folder.posts.map((post) => (
                  <li>
                    <a
                      href={postPath(post)}
                      title={post.data.title}
                      class={itemClass}
                      aria-current={post.id === currentPost?.id ? 'page' : undefined}
                    >
                      <Icon name="file-text" class="size-3.5 shrink-0" />
                      <span class="truncate">{post.data.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="mt-auto flex items-center justify-between border-t border-border pt-sm">
    <div class="flex items-center">
      <a
        href="https://github.com/KimDanwoo"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground"
        aria-label="GitHub"
      >
        <Icon name="github" />
      </a>
      <a
        href="https://lab.danwoo.dev"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-9 items-center gap-xs rounded-md px-sm text-muted-foreground hover:bg-muted hover:text-foreground"
      >
        Labs <Icon name="arrow-up-right" class="size-3" />
      </a>
    </div>
    <ThemeToggle />
  </div>
</div>
