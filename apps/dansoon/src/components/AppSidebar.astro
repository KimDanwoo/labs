---
import Icon from '~/components/Icon.astro';
import { filterByCategory, filterBySeries, postPath, seriesPath, type Post } from '~/lib/posts';
import { CATEGORY_IDS, CATEGORY_LABEL, SERIES_IDS, SERIES_INFO } from '~/lib/taxonomy';

type Props = {
  posts: Post[];
};

const { posts } = Astro.props;
const { pathname } = Astro.url;
const currentPost = posts.find((post) => postPath(post) === pathname);

/** activePrefixes: 이 경로로 시작해도 현재 위치로 본다. 클라이언트 갱신(BaseLayout)도 같은 규칙을 쓴다. */
const SHORTCUTS = [
  { href: '/', label: '전체 글', activePrefixes: ['/categories'] },
  { href: '/tags/', label: '태그', activePrefixes: ['/tags'] },
  { href: '/about/', label: '소개', activePrefixes: [] },
];
const isShortcutActive = ({ href, activePrefixes }: (typeof SHORTCUTS)[number]) =>
  pathname === href || activePrefixes.some((prefix) => pathname.startsWith(prefix));
// global.css의 --motion-base와 같은 값에서 시작해 글 수만큼 늘린다
const EXPAND_BASE_MS = 260;
const EXPAND_MS_PER_POST = 12;
const EXPAND_MAX_MS = 640;
const expandDurationOf = (postCount: number) =>
  `${Math.min(EXPAND_BASE_MS + postCount * EXPAND_MS_PER_POST, EXPAND_MAX_MS)}ms`;

const groups = CATEGORY_IDS.map((category) => {
  const categoryPosts = filterByCategory(posts, category);
  return {
    category,
    label: CATEGORY_LABEL[category],
    posts: categoryPosts,
    expandDuration: expandDurationOf(categoryPosts.length),
  };
});
const seriesLinks = SERIES_IDS.map((series) => ({
  href: seriesPath(series),
  label: SERIES_INFO[series].label,
  count: filterBySeries(posts, series).length,
})).filter(({ count }) => count > 0);
const navLinkClass =
  'rounded-md px-sm py-1.5 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground active:bg-muted aria-[current=page]:bg-primary-subtle aria-[current=page]:font-bold aria-[current=page]:text-primary dark:aria-[current=page]:text-primary-accent';
---

<div data-sidebar-content class="px-md pt-sm pb-md">
  <nav aria-label="바로가기">
    <ul class="space-y-0.5">
      {
        SHORTCUTS.map((item) => (
          <li>
            <a
              href={item.href}
              data-nav-link
              data-active-prefixes={item.activePrefixes.join(' ')}
              aria-current={isShortcutActive(item) ? 'page' : undefined}
              class:list={['block', navLinkClass]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <nav aria-label="카테고리별 글" class="mt-xl">
    {
      groups.map((group) => (
        <details
          name="sidebar-category"
          open={group.category === currentPost?.data.category}
          style={`--details-duration: ${group.expandDuration}`}
          class="motion-details group mb-sm"
        >
          <summary class="flex cursor-pointer list-none items-center gap-xs rounded-md px-sm py-1.5 text-sm font-bold transition-colors hover:bg-muted active:bg-muted [&::-webkit-details-marker]:hidden">
            <Icon
              name="chevron-right"
              class="size-3.5 shrink-0 text-muted-foreground transition-transform group-open:rotate-90"
            />
            <span data-category={group.category} class="category-dot" aria-hidden="true" />
            {group.label}
            <span class="ml-auto text-xs font-normal text-muted-foreground tabular-nums">{group.posts.length}</span>
          </summary>
          <ul class="mt-xs mb-md ml-sm border-l border-border">
            {group.posts.map((post) => (
              <li>
                <a
                  href={postPath(post)}
                  data-nav-link
                  aria-current={post.id === currentPost?.id ? 'page' : undefined}
                  class="-ml-px block border-l-2 border-transparent py-1.5 pr-sm pl-md text-sm leading-snug text-muted-foreground transition-colors hover:text-foreground aria-[current=page]:border-primary aria-[current=page]:font-bold aria-[current=page]:text-primary"
                >
                  <span class="line-clamp-2">{post.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </nav>

  {
    seriesLinks.length > 0 && (
      <nav aria-labelledby="sidebar-series" class="mt-lg">
        <p id="sidebar-series" class="px-sm pb-xs text-xs font-bold text-muted-foreground">
          연재
        </p>
        <ul class="space-y-0.5">
          {seriesLinks.map((item) => (
            <li>
              <a
                href={item.href}
                data-nav-link
                aria-current={pathname === item.href ? 'page' : undefined}
                class:list={['flex items-center gap-sm', navLinkClass]}
              >
                <span class="min-w-0 flex-1 truncate">{item.label}</span>
                <span class="text-xs font-normal tabular-nums">{item.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</div>
