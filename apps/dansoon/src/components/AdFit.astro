<aside class="adfit-slot" aria-label="광고"></aside>

<script>
  // 자리 폭에 맞는 단위 하나만 삽입한다 — 둘 다 넣고 CSS로 숨기면 노출 집계가 왜곡돼 제재 사유가 된다
  const UNITS = {
    pc: { unit: 'DAN-8vKsCr57ivUR97pn', width: 728, height: 90 },
    mobile: { unit: 'DAN-QHiQQni8uspeE4y8', width: 320, height: 100 },
  } as const;

  // ba.min.js는 로드 시점의 .kakao_ad_area만 처리하므로, 페이지를 옮길 때마다 광고 자리와 로더를 새로 넣는다
  function renderAds() {
    document.querySelectorAll<HTMLElement>('.adfit-slot').forEach((slot) => {
      // 창 폭이 아니라 실제 자리 폭으로 고른다 — 본문 칼럼(672px)에는 728 배너가 들어가지 않는다
      const { unit, width, height } = slot.clientWidth >= UNITS.pc.width ? UNITS.pc : UNITS.mobile;
      const ins = document.createElement('ins');
      ins.className = 'kakao_ad_area';
      ins.style.display = 'none';
      ins.dataset.adUnit = unit;
      ins.dataset.adWidth = String(width);
      ins.dataset.adHeight = String(height);
      const loader = document.createElement('script');
      loader.async = true;
      loader.src = 'https://t1.kakaocdn.net/kas/static/ba.min.js';
      slot.replaceChildren(ins, loader);
    });
  }

  // 카카오 로더가 넣는 iframe에는 제목이 없어 스크린 리더가 "프레임"으로만 읽는다 — 들어오는 대로 붙인다
  const AD_FRAME_TITLE = '광고';
  const labelAdFrames = new MutationObserver(() =>
    document
      .querySelectorAll<HTMLIFrameElement>('.adfit-slot iframe:not([title])')
      .forEach((frame) => frame.setAttribute('title', AD_FRAME_TITLE)),
  );
  // 페이지를 옮기면 body가 통째로 바뀌므로 그대로 남는 html을 지켜본다
  labelAdFrames.observe(document.documentElement, { childList: true, subtree: true });

  document.addEventListener('astro:page-load', renderAds);
</script>

<style>
  .adfit-slot {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100px;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-muted);
  }

  .adfit-slot::before {
    content: 'AD';
    position: absolute;
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    color: var(--color-muted-foreground);
  }

  .adfit-slot:has(iframe) {
    border: none;
    background: none;
  }

  .adfit-slot:has(iframe)::before {
    display: none;
  }
</style>
