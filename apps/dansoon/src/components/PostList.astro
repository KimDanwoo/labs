---
import Icon from '~/components/Icon.astro';
import { formatShortDate, yearOf } from '~/lib/format';
import { postPath, type Post } from '~/lib/posts';
import { CATEGORY_LABEL } from '~/lib/taxonomy';

type Props = {
  posts: Post[];
};

/** 노션 데이터베이스 표처럼: 제목 | 카테고리 | 날짜. 연도별로 묶는다(posts는 최신순). */
const { posts } = Astro.props;
const postsByYear = Map.groupBy(posts, (post) => yearOf(post.data.publishedAt));
const columnsClass = 'md:grid md:grid-cols-[minmax(0,1fr)_5rem_6rem] md:items-center md:gap-md';
---

{
  posts.length === 0 ? (
    <p class="py-2xl text-center text-sm text-muted-foreground">아직 글이 없어요.</p>
  ) : (
    <div>
      <div
        class:list={[columnsClass, 'hidden border-b border-border px-sm pb-sm text-xs text-muted-foreground md:grid']}
        aria-hidden="true"
      >
        <span class="flex items-center gap-xs">
          <Icon name="file-text" class="size-3.5" />
          제목
        </span>
        <span class="flex items-center gap-xs">
          <Icon name="folder" class="size-3.5" />
          카테고리
        </span>
        <span class="flex items-center gap-xs">
          <Icon name="calendar" class="size-3.5" />
          작성일
        </span>
      </div>
      {[...postsByYear].map(([year, yearPosts]) => (
        <section aria-labelledby={`year-${year}`} class="mt-lg first:mt-md">
          <h2 id={`year-${year}`} class="px-sm pb-xs text-xs font-semibold text-muted-foreground">
            {year} <span class="font-normal">· {yearPosts.length}</span>
          </h2>
          <ul>
            {yearPosts.map((post) => (
              <li>
                <a
                  href={postPath(post)}
                  class:list={[columnsClass, 'group block rounded-md px-sm py-sm transition-colors hover:bg-muted']}
                >
                  <span class="flex min-w-0 items-start gap-sm">
                    <Icon name="file-text" class="mt-1 size-4 shrink-0 text-muted-foreground" />
                    <span class="min-w-0">
                      <span class="block font-medium group-hover:underline group-hover:underline-offset-4">
                        {post.data.title}
                      </span>
                      <span class="mt-0.5 block truncate text-sm text-muted-foreground">{post.data.description}</span>
                    </span>
                  </span>
                  <span class="mt-xs ml-lg inline-flex md:mt-0 md:ml-0">
                    <span class="rounded-sm bg-muted px-xs py-0.5 text-xs text-muted-foreground">
                      {CATEGORY_LABEL[post.data.category]}
                    </span>
                  </span>
                  <time
                    datetime={post.data.publishedAt.toISOString()}
                    class="ml-sm text-xs text-muted-foreground tabular-nums md:ml-0 md:text-sm"
                  >
                    {formatShortDate(post.data.publishedAt)}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )
}
