---
import Icon from '~/components/Icon.astro';
---

<button
  type="button"
  data-theme-toggle
  class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
  aria-label="다크 모드 켜기"
>
  <Icon name="moon" class="size-4 dark:hidden" />
  <Icon name="sun" class="hidden size-4 dark:block" />
</button>

<script>
  const THEME_STORAGE_KEY = 'theme';

  function syncLabel(button: HTMLButtonElement, isDark: boolean) {
    button.setAttribute('aria-label', isDark ? '라이트 모드 켜기' : '다크 모드 켜기');
  }

  function saveTheme(isDark: boolean) {
    try {
      localStorage.setItem(THEME_STORAGE_KEY, isDark ? 'dark' : 'light');
    } catch {
      // 저장소가 막힌 환경(사생활 보호 모드 등)에서는 이번 방문에만 적용된다
    }
  }

  const IRIS_DURATION_MS = 600;
  const IRIS_EASING = 'cubic-bezier(0.65, 0, 0.35, 1)';
  // global.css가 이 클래스가 붙은 동안만 페이지 이동용 전환 애니메이션을 끄고 원형 전환을 쓴다
  const THEME_TRANSITION_CLASS = 'theme-transition';
  const COLLAPSE_CLASS = 'theme-transition-collapse';

  type Point = { x: number; y: number };
  type IrisDirection = 'collapse' | 'expand';

  const IRIS_BY_DIRECTION = {
    collapse: { pseudoElement: '::view-transition-old(root)', isShrinking: true },
    expand: { pseudoElement: '::view-transition-new(root)', isShrinking: false },
  } satisfies Record<IrisDirection, { pseudoElement: string; isShrinking: boolean }>;

  const syncAllLabels = (isDark: boolean) =>
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => syncLabel(button, isDark));

  function applyTheme() {
    const isDark = document.documentElement.classList.toggle('dark');
    saveTheme(isDark);
    syncAllLabels(isDark);
    document.dispatchEvent(new CustomEvent('themechange', { detail: { isDark } }));
  }

  const centerOf = (element: Element): Point => {
    const rect = element.getBoundingClientRect();
    return { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
  };

  const farthestCornerDistance = ({ x, y }: Point) =>
    Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));

  const circleAt = (radius: number, { x, y }: Point) => `circle(${radius}px at ${x}px ${y}px)`;

  const canAnimateThemeChange = () =>
    'startViewTransition' in document && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function animateIris(direction: IrisDirection, origin: Point): Animation {
    const { pseudoElement, isShrinking } = IRIS_BY_DIRECTION[direction];
    const open = circleAt(farthestCornerDistance(origin), origin);
    const closed = circleAt(0, origin);
    return document.documentElement.animate(
      { clipPath: isShrinking ? [open, closed] : [closed, open] },
      { duration: IRIS_DURATION_MS, easing: IRIS_EASING, fill: 'forwards', pseudoElement },
    );
  }

  function changeTheme(trigger: Element) {
    if (!canAnimateThemeChange()) {
      applyTheme();
      return;
    }

    const root = document.documentElement;
    const direction: IrisDirection = root.classList.contains('dark') ? 'expand' : 'collapse';
    const transitionClasses =
      direction === 'collapse' ? [THEME_TRANSITION_CLASS, COLLAPSE_CLASS] : [THEME_TRANSITION_CLASS];
    root.classList.add(...transitionClasses);
    const transition = document.startViewTransition(applyTheme);
    // 페이지 이동 전환과 겹쳐 건너뛰면 ready가 거절된다 — 테마는 이미 바뀌었으므로 애니메이션만 생략한다
    const iris = transition.ready.then(() => animateIris(direction, centerOf(trigger))).catch(() => undefined);
    // fill: forwards 애니메이션을 남겨 두면 다음 전환의 같은 의사 요소에 다시 걸려 화면이 비므로 끝나면 지운다
    transition.finished.finally(async () => {
      root.classList.remove(...transitionClasses);
      (await iris)?.cancel();
    });
  }

  document.addEventListener('astro:page-load', () =>
    syncAllLabels(document.documentElement.classList.contains('dark')),
  );
  // 복제된 사이드바(모바일 서랍) 안의 버튼도 동작하도록 클릭은 문서에서 받는다
  document.addEventListener('click', (event) => {
    const trigger = event.target instanceof Element ? event.target.closest('[data-theme-toggle]') : null;
    if (trigger) changeTheme(trigger);
  });
</script>
