---
import Icon from '~/components/Icon.astro';
import { postPath, seriesPath, type Post } from '~/lib/posts';
import { SERIES_INFO, type SeriesId } from '~/lib/taxonomy';

type Props = {
  series: SeriesId;
  posts: Post[];
  current: Post;
};

/** 노션 콜아웃처럼 회색 상자에 연재 목록을 담는다. */
const { series, posts, current } = Astro.props;
const position = posts.findIndex((post) => post.id === current.id) + 1;
---

<details class="group rounded-lg bg-muted">
  <summary
    class="flex cursor-pointer list-none items-center gap-sm px-md py-sm text-sm [&::-webkit-details-marker]:hidden"
  >
    <Icon name="layers" class="size-4 shrink-0 text-muted-foreground" />
    <span class="min-w-0 flex-1">
      <a href={seriesPath(series)} class="font-semibold hover:underline hover:underline-offset-4">
        {SERIES_INFO[series].label}
      </a>
      <span class="ml-xs text-muted-foreground tabular-nums">{position} / {posts.length}편</span>
    </span>
    <Icon name="chevron-down" class="size-4 text-muted-foreground transition-transform group-open:rotate-180" />
  </summary>
  <ol class="px-sm pb-sm text-sm">
    {
      posts.map((post, index) => (
        <li>
          <a
            href={postPath(post)}
            aria-current={post.id === current.id ? 'page' : undefined}
            class="flex gap-sm rounded-md px-sm py-1.5 text-muted-foreground transition-colors hover:bg-background hover:text-foreground aria-[current=page]:bg-background aria-[current=page]:font-semibold aria-[current=page]:text-foreground"
          >
            <span class="w-4 shrink-0 text-right tabular-nums">{index + 1}</span>
            <span>{post.data.title}</span>
          </a>
        </li>
      ))
    }
  </ol>
</details>
