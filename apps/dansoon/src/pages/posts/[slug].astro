---
import type { GetStaticPaths } from 'astro';
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import AdFit from '~/components/AdFit.astro';
import CategoryBadge from '~/components/CategoryBadge.astro';
import CopyLinkButton from '~/components/CopyLinkButton.astro';
import Giscus from '~/components/Giscus.astro';
import ImageLightbox from '~/components/ImageLightbox.astro';
import PostNav from '~/components/PostNav.astro';
import RelatedPosts from '~/components/RelatedPosts.astro';
import TagChips from '~/components/TagChips.astro';
import Toc from '~/components/Toc.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { formatLongDate, readingMinutes } from '~/lib/format';
import { getAdjacentPosts, getPublishedPosts, getRelatedPosts, postPath, type Post } from '~/lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}) satisfies GetStaticPaths;

type Props = {
  post: Post;
  posts: Post[];
};

const { post, posts } = Astro.props;
const { title, description, publishedAt, updatedAt, category, tags, thumbnail } = post.data;
const { Content, headings } = await render(post);
const { older, newer } = getAdjacentPosts(posts, post);
// 가로 썸네일만 제목 위 커버로 쓴다 — 예전 글의 정사각 제목 카드는 목록에만 둔다
const cover = thumbnail && thumbnail.width > thumbnail.height ? thumbnail : undefined;
const COVER_WIDTH = 1344;
// SNS 미리보기는 jpg/png 1200px가 가장 무난하다
const OG_IMAGE_WIDTH = 1200;
// 썸네일이 없으면 빌드 때 만든 제목 카드(/og/posts/<id>.png)를 쓴다
const ogImage = thumbnail
  ? (await getImage({ src: thumbnail, width: OG_IMAGE_WIDTH, format: 'jpg' })).src
  : `/og/posts/${post.id}.png`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: { '@type': 'Person', name: '김단우', url: 'https://lab.danwoo.dev' },
  mainEntityOfPage: new URL(postPath(post), Astro.site).href,
  inLanguage: 'ko',
  ...(ogImage ? { image: new URL(ogImage, Astro.site).href } : {}),
};
// 제목 등에 '</script>'가 들어가도 태그를 빠져나가지 못하게 '<'를 이스케이프한다
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<BaseLayout title={title} description={description} image={ogImage} article={{ publishedAt, updatedAt }}>
  <script is:inline slot="head" type="application/ld+json" set:html={structuredDataJson} />

  <div class="reading-progress" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-md sm:px-xl xl:grid xl:grid-cols-[minmax(0,1fr)_var(--container-3xs)] xl:gap-3xl">
    <article class="mx-auto w-full max-w-(--container-2xl) min-w-0 pt-2xl pb-xl sm:pt-3xl">
      <header>
        {
          cover && (
            <Image
              src={cover}
              alt=""
              width={COVER_WIDTH}
              loading="eager"
              fetchpriority="high"
              class="mb-xl aspect-video w-full rounded-xl object-cover ring-1 ring-border"
            />
          )
        }
        <CategoryBadge category={category} asLink />
        <h1 class="mt-md text-3xl leading-[1.3] font-bold tracking-tight text-balance sm:text-4xl">
          {title}
        </h1>
        <p class="mt-lg flex flex-wrap items-center gap-x-sm gap-y-xs text-sm text-muted-foreground">
          <time datetime={publishedAt.toISOString()}>{formatLongDate(publishedAt)}</time>
          {
            updatedAt && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  <time datetime={updatedAt.toISOString()}>{formatLongDate(updatedAt)}</time> 수정
                </span>
              </>
            )
          }
          <span aria-hidden="true">·</span>
          <span>{readingMinutes(post.body)}분 분량</span>
        </p>
        <div class="mt-md">
          <TagChips tags={tags} />
        </div>
      </header>

      <div class="mt-xl xl:hidden">
        <Toc headings={headings} variant="inline" />
      </div>

      <div class="article prose mt-2xl max-w-none">
        <Content />
      </div>

      <footer class="mt-3xl space-y-2xl border-t border-border pt-xl">
        <div class="flex justify-end">
          <CopyLinkButton />
        </div>
        <PostNav older={older} newer={newer} />
        <RelatedPosts posts={getRelatedPosts(posts, post)} />
        <AdFit />
        <Giscus />
      </footer>
    </article>

    <aside class="hidden xl:block" aria-label="글 목차">
      <!-- 고정(sticky)은 바깥 요소가, 목차가 길 때의 스크롤은 안쪽 요소가 맡는다(스크롤바 라이브러리가 대상의 position을 바꾼다) -->
      <div class="sticky top-0">
        <div data-overlay-scroll class="max-h-dvh overflow-y-auto pt-3xl pb-xl">
          <Toc headings={headings} variant="sidebar" />
        </div>
      </div>
    </aside>
  </div>

  <ImageLightbox />
</BaseLayout>
