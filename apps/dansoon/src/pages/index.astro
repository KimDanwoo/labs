---
import CategoryTabs from '~/components/CategoryTabs.astro';
import ListPage from '~/components/ListPage.astro';
import PostList from '~/components/PostList.astro';
import { getPublishedPosts } from '~/lib/posts';

const posts = await getPublishedPosts();
---

<ListPage heading="전체 글" icon="home" lead="프론트엔드 엔지니어 김단우의 개발 노트, 회고, 독서 기록">
  <div slot="header" class="mt-lg">
    <CategoryTabs posts={posts} active="all" />
  </div>
  <PostList posts={posts} />
</ListPage>
