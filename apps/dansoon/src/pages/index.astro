---
import CategoryTabs from '~/components/CategoryTabs.astro';
import ListPage from '~/components/ListPage.astro';
import PostList from '~/components/PostList.astro';
import { getPublishedPosts } from '~/lib/posts';

const posts = await getPublishedPosts();
---

<ListPage heading="개발하며 배운 것들" lead="프론트엔드 엔지니어 김단우가 만들고 부딪히며 배운 것을 기록합니다.">
  <div slot="header" class="mt-lg">
    <CategoryTabs posts={posts} active="all" />
  </div>
  <PostList posts={posts} />
</ListPage>
