---
import CategoryTabs from '~/components/CategoryTabs.astro';
import ListPage from '~/components/ListPage.astro';
import PostList from '~/components/PostList.astro';
import { getPublishedPosts } from '~/lib/posts';

const posts = await getPublishedPosts();
---

<ListPage heading="전체 글" lead="개발하면서 배운 것과 회고, 읽은 책 이야기를 적어요.">
  <div slot="header" class="mt-lg">
    <CategoryTabs posts={posts} active="all" />
  </div>
  <PostList posts={posts} />
</ListPage>
