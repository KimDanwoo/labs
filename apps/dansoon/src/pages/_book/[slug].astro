---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Toc from '~/components/Toc.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { bookReportPath, getBookReports, REPORT_KIND_LABEL, type BookReport } from '~/lib/books';
import { formatLongDate } from '~/lib/format';

export const getStaticPaths = (async () => {
  const reports = await getBookReports();
  return reports.map((report) => ({ params: { slug: report.id }, props: { report } }));
}) satisfies GetStaticPaths;

type Props = {
  report: BookReport;
};

const { report } = Astro.props;
const { title, description, date, category, note } = report.data;
const { Content, headings } = await render(report);
// 애드센스 심사 동안 자동 생성 리포트는 검색 색인에서 뺀다(BaseLayout의 noindex).
// 승인 후 이 값과 astro.config.mjs의 sitemap filter를 함께 걷어 낸다.
const IS_EXCLUDED_FROM_SEARCH = true;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: date.toISOString(),
  author: { '@type': 'Person', name: '김단우', url: 'https://lab.danwoo.dev' },
  mainEntityOfPage: new URL(bookReportPath(report), Astro.site).href,
  inLanguage: 'ko',
};
// 제목 등에 '</script>'가 들어가도 태그를 빠져나가지 못하게 '<'를 이스케이프한다
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<BaseLayout
  title={title}
  description={description}
  image={`/og/book/${report.id}.png`}
  article={{ publishedAt: date }}
  noindex={IS_EXCLUDED_FROM_SEARCH}
>
  <script is:inline slot="head" type="application/ld+json" set:html={structuredDataJson} />
  <div class="mx-auto max-w-6xl px-md sm:px-xl xl:grid xl:grid-cols-[minmax(0,1fr)_var(--container-3xs)] xl:gap-3xl">
    <article class="mx-auto w-full max-w-(--container-4xl) min-w-0 pt-2xl pb-xl sm:pt-3xl">
      <header>
        <a href="/book/" class="text-sm font-bold text-primary hover:underline">
          주간 책 순위 · {REPORT_KIND_LABEL[category]}
        </a>
        <h1 class="mt-md text-3xl leading-[1.3] font-bold tracking-tight text-balance sm:text-4xl">{title}</h1>
        <p class="mt-md text-sm text-muted-foreground">
          <time datetime={date.toISOString()}>{formatLongDate(date)}</time> 기준
        </p>
        {
          note && (
            <aside class="mt-lg rounded-lg border border-border px-lg py-md" aria-label="이번 주 메모">
              <p class="text-sm font-bold">이번 주 메모</p>
              <p class="mt-xs text-sm leading-relaxed text-muted-foreground">{note}</p>
            </aside>
          )
        }
      </header>

      <div class="mt-xl xl:hidden">
        <Toc headings={headings} variant="inline" />
      </div>

      <div class="article prose mt-2xl max-w-none">
        <Content />
      </div>
    </article>

    <aside class="hidden xl:block" aria-label="리포트 목차">
      <div class="sticky top-0">
        <div data-overlay-scroll class="max-h-dvh overflow-y-auto pt-3xl pb-xl">
          <Toc headings={headings} variant="sidebar" />
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>
