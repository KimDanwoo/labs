---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Toc from '~/components/Toc.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getBookReports, REPORT_KIND_LABEL, type BookReport } from '~/lib/books';
import { formatLongDate } from '~/lib/format';

export const getStaticPaths = (async () => {
  const reports = await getBookReports();
  return reports.map((report) => ({ params: { slug: report.id }, props: { report } }));
}) satisfies GetStaticPaths;

type Props = {
  report: BookReport;
};

const { report } = Astro.props;
const { title, description, date, category } = report.data;
const { Content, headings } = await render(report);
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-6xl px-md sm:px-xl xl:grid xl:grid-cols-[minmax(0,1fr)_var(--container-3xs)] xl:gap-3xl">
    <!-- 순위 표가 넓어 글보다 넓은 칼럼을 쓴다 -->
    <article class="mx-auto w-full max-w-(--container-4xl) min-w-0 pt-2xl pb-xl sm:pt-3xl">
      <header>
        <a href="/book/" class="text-sm font-bold text-primary hover:underline">
          주간 책 순위 · {REPORT_KIND_LABEL[category]}
        </a>
        <h1 class="mt-md text-3xl leading-[1.3] font-bold tracking-tight text-balance sm:text-4xl">{title}</h1>
        <p class="mt-md text-sm text-muted-foreground">
          <time datetime={date.toISOString()}>{formatLongDate(date)}</time> 기준
        </p>
      </header>

      <div class="mt-xl xl:hidden">
        <Toc headings={headings} variant="inline" />
      </div>

      <div class="article prose mt-2xl max-w-none">
        <Content />
      </div>
    </article>

    <aside class="hidden xl:block" aria-label="리포트 목차">
      <div class="sticky top-0">
        <div data-overlay-scroll class="max-h-dvh overflow-y-auto pt-3xl pb-xl">
          <Toc headings={headings} variant="sidebar" />
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>
