---
import BaseLayout from '~/layouts/BaseLayout.astro';

type Props = {
  frontmatter: {
    title: string;
    description: string;
  };
};

/** 소개·개인정보처리방침처럼 마크다운으로 쓰는 단독 페이지. 글 본문과 같은 읽기 스타일을 쓴다. */
const { title, description } = Astro.props.frontmatter;
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto w-full max-w-(--container-2xl) px-md pt-2xl pb-3xl sm:px-xl sm:pt-3xl">
    <h1 class="text-3xl leading-[1.3] font-bold tracking-tight sm:text-4xl">{title}</h1>
    <div class="article prose mt-2xl max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
