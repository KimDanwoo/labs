---
import '@tokens/css/fonts.css';
import '~/styles/global.css';
import AppSidebar from '~/components/AppSidebar.astro';
import Icon from '~/components/Icon.astro';
import MobileTopBar from '~/components/MobileTopBar.astro';
import SearchDialog from '~/components/SearchDialog.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import { getPublishedPosts } from '~/lib/posts';

const SITE_TITLE = 'Dansoon';
const SITE_DESCRIPTION = '프론트엔드 엔지니어 김단우의 개발 노트, 회고, 독서 기록';
// og.png를 바꾸면 v를 올려야 SNS 캐시가 갱신된다
const DEFAULT_OG_IMAGE = '/og.png?v=2';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  article?: { publishedAt: Date; updatedAt?: Date };
};

const { title, description = SITE_DESCRIPTION, image = DEFAULT_OG_IMAGE, article } = Astro.props;
const posts = await getPublishedPosts();
const fullTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <meta name="google-site-verification" content="-kohA7qdl_10fMUGOMlZ7EArpE6vOn0DHONUwImizX8" />

    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    {article && <meta property="article:published_time" content={article.publishedAt.toISOString()} />}
    {article?.updatedAt && <meta property="article:modified_time" content={article.updatedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />

    <!-- 첫 페인트 전에 테마를 정해 깜빡임을 막는다. 저장값이 없으면 OS 설정을 따른다. -->
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {}
        const isDark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>
  </head>

  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-sm focus:left-sm focus:z-50 focus:rounded-md focus:bg-primary focus:px-md focus:py-sm focus:text-primary-foreground"
    >
      본문으로 건너뛰기
    </a>
    <div class="lg:grid lg:grid-cols-[var(--container-3xs)_minmax(0,1fr)]">
      <aside
        data-sidebar
        aria-label="사이트 탐색"
        class="sticky top-0 hidden h-dvh overflow-y-auto border-r border-border bg-secondary-subtle lg:block"
      >
        <AppSidebar posts={posts} />
      </aside>
      <div class="flex min-h-dvh min-w-0 flex-col">
        <MobileTopBar />
        <main id="main" class="flex-1">
          <slot />
        </main>
        <SiteFooter />
      </div>
    </div>

    <dialog
      id="mobile-nav"
      aria-label="사이트 탐색"
      class="fixed inset-y-0 left-0 m-0 h-dvh max-h-none w-72 max-w-[85vw] bg-secondary-subtle p-0 text-foreground"
    >
      <button
        type="button"
        data-nav-close
        autofocus
        class="absolute top-sm right-sm z-10 inline-flex size-9 items-center justify-center rounded-md text-muted-foreground hover:bg-muted"
        aria-label="메뉴 닫기"
      >
        <Icon name="x" />
      </button>
      <AppSidebar posts={posts} />
    </dialog>
    <SearchDialog />

    <script>
      const mobileNav = document.querySelector<HTMLDialogElement>('#mobile-nav');
      document.querySelector('[data-nav-open]')?.addEventListener('click', () => mobileNav?.showModal());
      mobileNav?.querySelector('[data-nav-close]')?.addEventListener('click', () => mobileNav.close());
      mobileNav?.addEventListener('click', (event) => {
        if (event.target === mobileNav) mobileNav.close();
      });
      // 검색을 열면 서랍은 닫는다(모달 두 개가 겹치지 않게)
      mobileNav
        ?.querySelectorAll('[data-search-open]')
        .forEach((button) => button.addEventListener('click', () => mobileNav.close()));

      // 사이드바에서 지금 글이 보이도록 사이드바 안에서만 스크롤한다(페이지 스크롤은 건드리지 않는다)
      const sidebar = document.querySelector<HTMLElement>('[data-sidebar]');
      const current = sidebar?.querySelector<HTMLElement>('details [aria-current="page"]');
      if (sidebar && current) sidebar.scrollTop = current.offsetTop - sidebar.clientHeight / 3;
    </script>
  </body>
</html>
