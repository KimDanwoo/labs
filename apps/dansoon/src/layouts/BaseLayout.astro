---
import '@tokens/css/fonts.css';
import '~/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import AppSidebar from '~/components/AppSidebar.astro';
import Icon from '~/components/Icon.astro';
import MobileTopBar from '~/components/MobileTopBar.astro';
import SearchDialog from '~/components/SearchDialog.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import { getPublishedPosts } from '~/lib/posts';

const SITE_TITLE = 'Dansoon';
const SITE_DESCRIPTION = '프론트엔드 개발을 하며 배운 것과 회고, 읽은 책을 기록해요.';
// og.png를 바꾸면 v를 올려야 SNS 캐시가 갱신된다
const DEFAULT_OG_IMAGE = '/og.png?v=2';
const GTM_ID = 'GTM-5SX6KQFC';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  article?: { publishedAt: Date; updatedAt?: Date };
};

const { title, description = SITE_DESCRIPTION, image = DEFAULT_OG_IMAGE, article } = Astro.props;
const posts = await getPublishedPosts();
const fullTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <meta name="google-site-verification" content="-kohA7qdl_10fMUGOMlZ7EArpE6vOn0DHONUwImizX8" />
    <meta name="google-adsense-account" content="ca-pub-4063325112682329" />

    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    {article && <meta property="article:published_time" content={article.publishedAt.toISOString()} />}
    {article?.updatedAt && <meta property="article:modified_time" content={article.updatedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <ClientRouter />

    <!-- 개발 서버 방문이 통계에 섞이지 않게 배포 빌드에만 넣는다 -->
    {
      import.meta.env.PROD && (
        <>
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
          </script>
          <script is:inline async src={`https://www.googletagmanager.com/gtm.js?id=${GTM_ID}`} />
        </>
      )
    }

    <!-- 첫 페인트 전에 테마를 정해 깜빡임을 막는다. 저장값이 없으면 OS 설정을 따른다.
         페이지를 옮기면 ClientRouter가 <html> 속성을 새 문서 것으로 바꾸므로, 바꾼 직후에도 다시 적용한다. -->
    <script is:inline>
      (() => {
        const applyTheme = (root) => {
          let saved = null;
          try {
            saved = localStorage.getItem('theme');
          } catch {}
          const isDark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          root.classList.toggle('dark', isDark);
        };
        applyTheme(document.documentElement);
        if (window.__dansoonThemeSync) return;
        window.__dansoonThemeSync = true;
        document.addEventListener('astro:before-swap', (event) => applyTheme(event.newDocument.documentElement));
      })();
    </script>
  </head>

  <body class="min-h-dvh lg:h-dvh lg:overflow-hidden">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-sm focus:left-sm focus:z-50 focus:rounded-md focus:bg-primary focus:px-md focus:py-sm focus:text-primary-foreground"
    >
      본문으로 건너뛰기
    </a>
    <div class="lg:grid lg:h-dvh lg:grid-cols-[var(--container-3xs)_minmax(0,1fr)]">
      <aside
        transition:persist="sidebar"
        aria-label="사이트 탐색"
        class="hidden h-dvh border-r border-border bg-secondary-subtle lg:block"
        style="view-transition-name: sidebar"
      >
        <!-- 사이드바는 자기 영역만 스크롤한다. 스크롤바 라이브러리는 안쪽 요소에 붙인다 -->
        <div data-sidebar class="h-full overflow-y-auto">
          <AppSidebar posts={posts} />
        </div>
      </aside>
      <!-- 데스크톱에서는 본문 영역이 스크롤 주체다(사이드바와 스크롤이 섞이지 않는다) -->
      <div data-content-scroll class="min-w-0 lg:h-dvh lg:overflow-y-auto">
        <div class="flex min-h-dvh flex-col">
          <MobileTopBar />
          <main id="main" class="flex-1" style="view-transition-name: page">
            <slot />
          </main>
          <SiteFooter />
        </div>
      </div>
    </div>

    <dialog
      id="mobile-nav"
      transition:persist
      aria-label="사이트 탐색"
      class="motion-dialog motion-drawer fixed inset-y-0 left-0 m-0 h-dvh max-h-none w-72 max-w-[85vw] bg-secondary-subtle p-0 text-foreground"
    >
      <button
        type="button"
        data-nav-close
        autofocus
        class="absolute top-sm right-sm z-10 inline-flex size-9 items-center justify-center rounded-md text-muted-foreground hover:bg-muted"
        aria-label="메뉴 닫기"
      >
        <Icon name="x" />
      </button>
      <!-- 처음 열 때 데스크톱 사이드바를 복제해 채운다(같은 목록을 두 번 그리지 않는다) -->
      <div data-mobile-nav-body></div>
    </dialog>
    <SearchDialog />

    <script>
      import '~/scripts/layout';
    </script>
  </body>
</html>
