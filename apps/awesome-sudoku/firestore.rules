rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Point bounds mirror POINT_RANGES in src/entities/game/model/constants/record.ts.
    function pointRanges() {
      return {
        'easy': [1, 3],
        'medium': [3, 6],
        'hard': [6, 9],
        'expert': [9, 12]
      };
    }

    function gameRecordFields() {
      return [
        'userId', 'userDisplayName', 'userPhotoURL', 'gameMode', 'difficulty', 'completionTime',
        'hintsUsed', 'mistakesCount', 'score', 'point', 'isSuccess', 'createdAt'
      ];
    }

    function isGooglePhotoUrl(url) {
      return url == null
        || (url is string && url.size() <= 2048 && url.matches('https://lh3[.]googleusercontent[.]com/.*'));
    }

    function isValidGameRecord(record) {
      let range = pointRanges().get(record.difficulty, null);
      return record.keys().hasOnly(gameRecordFields())
        && record.keys().hasAll(gameRecordFields())
        && record.userId == request.auth.uid
        && record.userDisplayName is string
        && record.userDisplayName.size() > 0
        && record.userDisplayName.size() <= 50
        && isGooglePhotoUrl(record.userPhotoURL)
        && record.gameMode in ['classic', 'killer']
        && range != null
        && record.completionTime is int
        && record.completionTime > 0
        && record.completionTime <= 604800
        && record.hintsUsed is int
        && record.hintsUsed >= 0
        && record.hintsUsed <= 3
        && record.mistakesCount is int
        && record.mistakesCount >= 0
        && record.mistakesCount <= 5
        && record.score is number
        && record.score == record.point
        && record.score >= range[0]
        && record.score <= range[1]
        && record.isSuccess == true
        && record.createdAt == request.time;
    }

    match /gameRecords/{recordId} {
      allow read: if true;
      allow create: if request.auth != null && isValidGameRecord(request.resource.data);
      allow update, delete: if false;
    }
  }
}
