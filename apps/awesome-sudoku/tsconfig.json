{
  "extends": "@config/tsconfig/next.json",
  "compilerOptions": {
    "paths": {
      "@app/*": ["./src/_app/*"],
      "@pages/*": ["./src/_pages/*"],
      "@widgets/*": ["./src/widgets/*"],
      "@features/*": ["./src/features/*"],
      "@entities/*": ["./src/entities/*"],
      "@shared/*": ["./src/shared/*"],
      "@test/*": ["./src/test/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
